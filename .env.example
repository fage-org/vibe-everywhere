# Vibe Everywhere Server Configuration
# Copy this file to .env and adjust values as needed

# Server listen address
LISTEN_ADDR=0.0.0.0:3000

# Database URL (SQLite by default)
# For SQLite: sqlite:./data/vibe.db
# For PostgreSQL: postgres://user:password@localhost/vibe
DATABASE_URL=sqlite:./data/vibe.db

# JWT secret key (must be at least 32 characters for security)
# Generate with: openssl rand -base64 32
# Example: JWT_SECRET=generate-a-secure-random-key-minimum-32-chars
JWT_SECRET=example-replace-with-your-secure-random-key-32-plus

# JWT expiration in seconds (default: 30 days = 2592000)
JWT_EXPIRATION_SECS=2592000

# Pairing code TTL in seconds (default: 5 minutes)
PAIR_CODE_TTL_SECS=300

# WebSocket heartbeat interval in seconds
HEARTBEAT_INTERVAL_SECS=30

# WebSocket connection timeout in seconds
CONNECTION_TIMEOUT_SECS=60

# Data directory for SQLite databases
DATA_DIR=./data

# CORS allowed origins (comma-separated)
# Empty = most restrictive (same-origin only)
# "*" = allow all origins (use only for development)
# Examples:
#   CORS_ORIGINS=https://app.example.com
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
#   CORS_ORIGINS=*  (development only)
CORS_ORIGINS=
